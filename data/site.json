  "info": {
    "statement": "Art director, designer and researcher based in Berlin, leading design at Therme Art and working across visual identities, editorial, exhibitions and digital experiences to translate complex ideas into cohesive visual languages.",
    "sections": [
      {
        "label": "Honors and Awards",
        "items": [
          {
            "year": "2019",
            "text": "Academy of Fine Arts Leipzig, Germany"
          },
          {
            "year": "2014",
            "text": "iF Communication Design Award, Germany"
          },
          {
            "year": "2013",
            "text": "Society for News Design Award, USA"
          },
          {
            "year": "2013–2017",
            "text": "Brazilian Graphic Design Biennial, multiple editions"
          }
        ]
      },
      {
        "label": "Publications",
        "items": [
          {
            "year": "2023",
            "text": "Words and worlds. The poetry of design between Brazil and Germany. In: The New Designer: Design as a Profession. Leipzig: Spector.",
            "href": "https://www.spectorbooks.com/de/buch/the-new-designer-design-as-a-profession"
          },
          {
            "year": "2022",
            "text": "Good form: a timeline. São Paulo: Act."
          },
          {
            "year": "2020",
            "text": "A search for multidimensional languages between Brazilian and German modernists. Berlin/Dessau: Bauhaus Imaginista Journal."
          },
          {
            "year": "2018",
            "text": "A battlefield in Brazilian art. Interview with Augusto de Campos. Contravento magazine."
          },
          {
            "year": "2016",
            "text": "Brasília in The Age of the Earth: notes for a figural analysis. Pós FAU USP."
          }
        ]
      },
      {
        "label": "Lectures and Seminars",
        "items": [
          {
            "year": "2020",
            "text": "Guest professor at Escola da Cidade and British School of Creative Arts, São Paulo, Brazil."
          },
          {
            "text": "Guest lecturer in the International Dialogue Series at the School of Architecture, Sharda University, Delhi, India."
          },
          {
            "year": "2019",
            "text": "Orangen und Karten, workshop organized together with Joachim Krausse and Sandra Giegler at the Bauhaus Museum Dessau, Germany."
          },
          {
            "year": "2015",
            "text": "Cyanotype workshop, São Paulo, Brazil."
          }
        ]
      },
      {
        "label": "Education",
        "items": [
          {
            "text": "MSc Design Research, Bauhaus Dessau, Anhalt University and Humboldt University, Berlin."
          },
          {
            "text": "MSc Architecture and Urbanism, University of São Paulo FAU-USP"
          },
          {
            "text": "BA Architecture and Urbanism, University of São Paulo FAU-USP"
          }
        ]
      },
