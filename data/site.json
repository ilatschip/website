            "text": "iF Communication Design Award, Germany"
          },
          {
            "year": "2013",
            "text": "Society for News Design Award, USA"
          },
          {
            "year": "2013–2017",
            "text": "Brazilian Graphic Design Biennial, multiple editions"
          }
        ]
      },
      {
