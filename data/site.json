  "projects": [
    {
      "slug": "therme-art",
      "title": "Therme Art",
      "year": "",
      "categories": [
        "art-direction",
        "web-design",
        "branding",
        "editorial",
        "ai"
      ],
      "location": "Berlin",
      "description": "Therme Art is Therme Group’s international cultural initiative, bringing together artists, architects, scientists and institutions around a shared vision of wellbeing culture. The project focuses on developing and maintaining a cohesive visual identity across a diverse range of cultural programmes, partnerships and platforms. Spanning visual identity, digital experiences, exhibitions, publications and spatial communications, the design system adapts to different scales, contexts and audiences while maintaining a distinct and recognisable visual language. Its applications include the Art Senses artist mentorship and commission programme, collaborations with Superblue, Art Basel, Manchester International Festival, Serpentine and the Venice Architecture Biennale, as well as the digital platform artsenses.art.",
      "credits": "Creative Direction, overall design",
